{
  "name": "dsh-launch-in-one-click",
  "version": "1.1.0",
  "description": "Generates and installs a verified one-click desktop launcher for DeepSeek Harness on Windows, after checking Node, npx, the desktop folder, and whether the target port is already serving a Harness instance.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "iconv-lite": "^0.7.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <0.2.0-0 || >=0.1.0-rc.1 <0.2.0-0 || >=0.1.1-rc.1 <0.2.0-0 || >=0.1.2-alpha.1 <0.2.0-0 || >=0.1.3-alpha.1 <0.2.0-0 || >=0.1.5-alpha.1 <0.2.0-0",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "launcher",
    "windows",
    "desktop",
    "one-click"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/233fxr-collab/dsh-launch-in-one-click.git"
  },
  "bugs": {
    "url": "https://github.com/233fxr-collab/dsh-launch-in-one-click/issues"
  },
  "homepage": "https://github.com/233fxr-collab/dsh-launch-in-one-click#readme"
}
